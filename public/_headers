# Security headers for every response (mirrors the previous vercel.json).
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin

# The admin panel is a private tool, never a search result. robots.txt already
# disallows it; this header is the defence-in-depth signal if a bot ignores it.
/admin*
  X-Robots-Tag: noindex, nofollow

# Long-lived immutable caching for versioned build assets.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
