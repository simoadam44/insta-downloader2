# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_PASSWORD: Password for accessing the protected /admin dashboard.
# REQUIRED in production (NODE_ENV=production): the server REFUSES TO START
# without it, and default/weak passwords are never accepted. Generate a
# strong one, e.g. PowerShell: -join ((48..122) | Get-Random -Count 24 | % {[char]$_})
ADMIN_PASSWORD=

# SESSION_SECRET: signs admin session tokens (HMAC-SHA256).
# REQUIRED in production: server refuses to start without it. Must be long
# and random, and MUST match across backend + Vercel functions.
SESSION_SECRET=

# Vercel frontend -> backend split (your architecture):
# Deploy frontend on Vercel, backend (server.ts, via Dockerfile) on a
# container host (Back4App / Render / Cloud Run), then set:
# VITE_API_BASE_URL=https://YOUR-BACKEND-xxx.back4app.com
VITE_API_BASE_URL=

# --- Supabase (free shared database for Keywords & Tools Engine) ---
# 1. Create a free project at https://supabase.com (500MB Postgres, free tier).
# 2. SQL Editor -> run supabase/schema.sql (creates + seeds the keyword_pages table).
# 3. Project Settings -> API -> copy the URL + service_role key below.
# Without these, keyword pages fall back to local-only mode (admin browser only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Instagram extraction: works automatically & FREE out of the box ---
# Default chain (no keys needed): kkscript mirrors -> Instagram oEmbed -> direct scrape.
# The variables below are OPTIONAL fallbacks for heavy traffic / extra reliability.

# Option A (optional): RapidAPI key — extra fallback when free mirrors are busy.
# Get it from: https://rapidapi.com/ (search "instagram downloader")
RAPIDAPI_KEY=
RAPIDAPI_HOST=instagram-downloader-download-instagram-videos-stories1.p.rapidapi.com

# Option B: self-hosted Cobalt API instance (https://github.com/imputnet/cobalt)
COBALT_API_URL=

# Option C: authenticated Instagram session (fallback for direct scraping).
# Create a throwaway IG account, log in, copy cookies. NEVER use your main account.
IG_SESSIONID=
IG_DS_USER_ID=
IG_CSRFTOKEN=

# PORT: Server listening port for Google Cloud Run (default: 8080 on Cloud Run, 3000 locally)
PORT=8080

