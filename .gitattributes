# Cloudflare Pages parses _redirects/_headers byte-wise: force LF so Windows
# checkouts can never smuggle CRLF into a deployed rule file.
public/_redirects text eol=lf
public/_headers text eol=lf
public/robots.txt text eol=lf
supabase/*.sql text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
